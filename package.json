{
  "name": "minh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:setup": "tsx scripts/dev/setup.ts",
    "dev": "tsx scripts/dev/run.ts",
    "dev:pay": "tsx scripts/dev/pay.ts",
    "dev:check": "tsx scripts/e2e.ts",
    "dev:reset": "tsx scripts/dev/reset.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
