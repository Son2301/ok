# ---- shared by every service -------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgres://minh:minh@postgres:5432/minh
# Long random secret shared by the web console and all services (openssl rand -hex 32).
INTERNAL_TOKEN=change-me-to-a-long-random-secret
# The org that pays for free tiers (Safe checks, Review free quota, Agents' included LLM quota).
PLATFORM_ORG_ID=org_platform
PLATFORM_ORG_INITIAL_CREDIT_USD=20
AGENTS_PLATFORM_ORG_ID=org_platform
SAFE_PLATFORM_ORG_ID=org_platform
REVIEW_PLATFORM_ORG_ID=org_platform
CONSOLE_URL=http://localhost:3000

# ---- web console -----------------------------------------------------------------
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SAFE_URL=http://localhost:4200
FOUNDER_NAME=
CONTACT_EMAIL=
CONTACT_ZALO=
COMPANY_TAX_CODE=
COOKIE_SECURE=false

# ---- gateway: providers (leave all empty to run fully offline on the mock provider) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
BYTEPLUS_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# ---- wallet: VietQR top-ups auto-confirmed by SePay ---------------------------
VND_PER_USD=26000
TOPUP_BANK_ID=
TOPUP_BANK_ACCOUNT_NO=
TOPUP_BANK_ACCOUNT_NAME=
SEPAY_API_KEY=

# ---- agents ---------------------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts integration credentials at rest.
AGENTS_ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:4100

# ---- safe -----------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
HIVE_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# ---- review (GitHub App) -------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
REVIEW_STATE_SECRET=
